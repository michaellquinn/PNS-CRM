# Custom environment variables & secrets for Ninja PNS.
#
# Substrait reads this file on upload and PRE-CREATES each entry under the app's
# Settings, so after uploading you just fill in the real values in the portal —
# no redeploy needed for the values to apply.
#
#   NAME=value            → an environment variable, prefilled with `value`
#   NAME=value   # secret → a secret (write-only; masked in the portal)
#
# Do NOT list DATABASE_URL or JWT_SECRET — the platform injects those.

# Identity fallback for LOCAL DEV ONLY. Google SSO is now enabled on this app, so
# the auth proxy injects x-forwarded-email and this is ignored on every gated
# request. It must stay EMPTY in the portal: any request that reaches the app
# without the SSO header (an SSO-exempt path, a misconfiguration) would otherwise
# be served as this user, delete rights included. The app shows a warning banner
# whenever it falls back to this value.
DEV_USER_EMAIL=

# ---------------------------------------------------------------- email
# Google Workspace SMTP relay. Leave SMTP_HOST or SMTP_FROM empty and the app sends no
# mail at all — notifications stay in the in-app bell, exactly as before.
#
# Mail goes out ONLY for things aimed at one person: assigned to you, tagged in a
# question, a ticket sent back to you, a file added to a ticket you own. Broadcast
# notifications are never emailed, which is what keeps this out of everyone's filters.
#
# A Workspace admin enables the relay at Apps > Google Workspace > Gmail > Routing >
# SMTP relay service, allowing this app's egress IP and "Only addresses in my domains".
# With IP authentication there are no credentials, so leave SMTP_USER/SMTP_PASSWORD
# empty. Verify with the Email delivery card under Administration > Users & roles.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_NAME=Ninja PNS
SMTP_USER=
SMTP_PASSWORD=   # secret

# Used to build the "Open the ticket" link in those emails. Without it the mail still
# sends, just with no link.
APP_URL=https://solutions-crm.apps.substrait.build

# ---------------------------------------------------------------- Sales CRM sync
# Pulls new opportunities from salescrm.ninjavan.co and raises the matching tickets.
#
# The key is issued PER PERSON and inherits that person's Sales CRM permissions, so a
# sync reads whatever its owner can see. It also expires after at most 30 days. Until
# Ninja issues a service account, SYNC_OWNER_EMAIL is the only person who may run it —
# otherwise the same sync returns different results depending on who pressed the button.
# Request a service account and this becomes a normal scheduled job.
SALESCRM_API_KEY=   # secret
SALESCRM_BASE=https://api.ninjavan.co/global/salescrm/api/v1
SYNC_OWNER_EMAIL=baskoro.nugroho@ninjavan.co

# Only opportunities with this Sales CRM record type are pulled. ID is the only book
# PNS solutions for; leave empty to pull every record type.
SALESCRM_RECORD_TYPE=Indonesia

# Set to 0 to switch off automatic PNS assignment entirely — every ticket then arrives
# unassigned for the Head to place. Assignment stops at the per-person cap either way.
AUTO_ASSIGN=1

# Rate-card references shown next to each pricing action (§11.1 of HANDOFF.md).
# Public Google Sheet URLs — not secrets.
RATECARD_LTL=
RATECARD_B2BR=
RATECARD_FTL=
RATECARD_SAMEDAY=
