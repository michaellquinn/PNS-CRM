# Frontend image for Substrait: build the Vite app, then serve the static bundle with
# nginx on port 80. Built from the REPO ROOT, so COPY paths are repo-relative.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
# Same-origin API: the ingress routes /api to the backend, so the app calls the backend
# via relative /api paths — no absolute URL is baked into the bundle.
ENV VITE_API_URL=""
RUN npm run build

FROM nginx:1.27-alpine
# Upgrade OS packages in the final stage to remediate known CVEs:
# c-ares (CVE-2026-33630), libcrypto3+libssl3 (CVE-2026-31789 et al.),
# libexpat (CVE-2025-59375 et al.), libpng (CVE-2025-64720 et al.),
# libxml2 (CVE-2025-32414 et al.), musl+musl-utils (CVE-2026-40200),
# nghttp2-libs (CVE-2026-27135), zlib (CVE-2026-22184)
# Every minimum below was confirmed present in the Alpine 3.21 index on 2026-09-22.
RUN apk update && apk add --no-cache \
    "c-ares>=1.34.8-r0" \
    "libcrypto3>=3.3.7-r1" \
    "libssl3>=3.3.7-r1" \
    "libexpat>=2.8.4-r0" \
    "libpng>=1.6.55-r0" \
    "libxml2>=2.13.9-r1" \
    "musl>=1.2.5-r11" \
    "musl-utils>=1.2.5-r11" \
    "nghttp2-libs>=1.68.1" \
    "zlib>=1.3.2-r0"
COPY --from=build /app/dist /usr/share/nginx/html
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
